<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="900" styleClass="root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.vieos.controlers.EstudianteController">
    <top>
        <VBox spacing="4" styleClass="header">
            <padding><Insets bottom="18" left="20" right="20" top="18" /></padding>
         <ImageView fitHeight="70.0" fitWidth="269.0" pickOnBounds="true" preserveRatio="true">
            <image>
               <Image url="@videos-logo.png" />
            </image>
            <VBox.margin>
               <Insets />
            </VBox.margin></ImageView>
            <Label styleClass="subtitle" text="Registro y administración de estudiantes" />
        </VBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets bottom="20" left="20" right="20" top="18" /></padding>

            <GridPane hgap="12" vgap="10">
                <Label text="Nombres" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtNombres" promptText="Ej. Juan Alberto" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <Label text="Apellidos" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <TextField fx:id="txtApellidos" promptText="Ej. López Herrera" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Carrera" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="txtCarrera" promptText="Ej. Ingeniería de Sistemas" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                <Label text="Fecha de nacimiento" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <DatePicker fx:id="dpFechaNac" promptText="Seleccione una fecha" GridPane.columnIndex="0" GridPane.rowIndex="3" />

                <CheckBox fx:id="chkTieneBeca" text="Tiene beca" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                <HBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="3">
                    <Button fx:id="btnAgregar" defaultButton="true" onAction="#guardarOnClick" text="Agregar estudiante" />
                    <Button onAction="#limpiarOnClick" text="Limpiar" />
                    <Button fx:id="btnEliminar" disable="true" onAction="#eliminarOnClick" text="Eliminar" />
                </HBox>

                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" />
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" />
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES" />
                </columnConstraints>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
               <RowConstraints />
            </rowConstraints>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="lblRegistros" styleClass="counter" text="Registros guardados: 0" />
                <Label styleClass="hint" text="Selecciona un registro para editarlo." />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="lblEstado" styleClass="status" text="Listo." />
            </HBox>

            <TableView fx:id="tblEstudiantes" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No hay estudiantes registrados todavía." />
                </placeholder>
                <columns>
                    <TableColumn fx:id="colNombres" prefWidth="145" text="Nombres" />
                    <TableColumn fx:id="colApellidos" prefWidth="145" text="Apellidos" />
                    <TableColumn fx:id="colCarrera" prefWidth="190" text="Carrera" />
                    <TableColumn fx:id="colFecha" prefWidth="105" text="Nacimiento" />
                    <TableColumn fx:id="colEdad" prefWidth="80" text="Edad" />
                    <TableColumn fx:id="colBeca" prefWidth="75" text="Beca" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
