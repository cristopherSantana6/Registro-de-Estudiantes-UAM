<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.vieos.controlers.EstudianteController"
            prefWidth="900" prefHeight="600" styleClass="root">
    <top>
        <VBox spacing="4" styleClass="header">
            <padding><Insets top="18" right="20" bottom="18" left="20"/></padding>
            <Label text="VIDEOS" styleClass="title"/>
            <Label text="Registro y administración de estudiantes" styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="14">
            <padding><Insets top="18" right="20" bottom="20" left="20"/></padding>

            <GridPane hgap="12" vgap="10">
                <Label text="Nombres" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNombres" promptText="Ej. Juan Alberto" GridPane.columnIndex="0" GridPane.rowIndex="1"/>

                <Label text="Apellidos" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <TextField fx:id="txtApellidos" promptText="Ej. López Herrera" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Carrera" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="txtCarrera" promptText="Ej. Ingeniería de Sistemas" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

                <Label text="Fecha de nacimiento" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dpFechaNac" promptText="Seleccione una fecha" GridPane.columnIndex="0" GridPane.rowIndex="3"/>

                <CheckBox fx:id="chkTieneBeca" text="Tiene beca" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <HBox spacing="8" GridPane.columnIndex="2" GridPane.rowIndex="3">
                    <Button fx:id="btnAgregar" text="Agregar estudiante" onAction="#guardarOnClick" defaultButton="true"/>
                    <Button text="Limpiar" onAction="#limpiarOnClick"/>
                    <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminarOnClick" disable="true"/>
                </HBox>

                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES"/>
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES"/>
                    <javafx.scene.layout.ColumnConstraints hgrow="SOMETIMES"/>
                </columnConstraints>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label fx:id="lblRegistros" text="Registros guardados: 0" styleClass="counter"/>
                <Label text="Selecciona un registro para editarlo." styleClass="hint"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblEstado" text="Listo." styleClass="status"/>
            </HBox>

            <TableView fx:id="tblEstudiantes" VBox.vgrow="ALWAYS">
                <placeholder>
                    <Label text="No hay estudiantes registrados todavía."/>
                </placeholder>
                <columns>
                    <TableColumn fx:id="colNombres" text="Nombres" prefWidth="145"/>
                    <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="145"/>
                    <TableColumn fx:id="colCarrera" text="Carrera" prefWidth="190"/>
                    <TableColumn fx:id="colFecha" text="Nacimiento" prefWidth="105"/>
                    <TableColumn fx:id="colEdad" text="Edad" prefWidth="80"/>
                    <TableColumn fx:id="colBeca" text="Beca" prefWidth="75"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
