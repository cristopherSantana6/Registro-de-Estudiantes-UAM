<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="620" prefWidth="430" spacing="16" style="-fx-background-color: #f4f7fa;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.vieos.controlers.LoginController">
    <padding>
        <Insets bottom="35" left="45" right="45" top="35" />
    </padding>

    <ImageView fitHeight="110" fitWidth="300" preserveRatio="true">
        <image>
            <Image preserveRatio="true" url="@videos-logo.png" />
        </image>
    </ImageView>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1f2937;" text="Bienvenido al registro" />
    <Label style="-fx-font-size: 14px; -fx-text-fill: #6b7280;" text="Inicia sesión para continuar" />

    <VBox maxWidth="330" spacing="7">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Usuario" />
        <TextField fx:id="txtUsuario" onAction="#iniciarSesion" prefHeight="42" promptText="Ingresa tu usuario" />

        <Label style="-fx-font-weight: bold; -fx-text-fill: #374151;" text="Contraseña" />
        <PasswordField fx:id="txtClave" onAction="#iniciarSesion" prefHeight="42" promptText="Ingresa tu contraseña" />
    </VBox>

    <Label fx:id="lblError" maxWidth="330" style="-fx-text-fill: #dc2626; -fx-font-size: 13px;" text="" wrapText="true" />

    <Button defaultButton="true" onAction="#iniciarSesion" prefHeight="45" prefWidth="330" style="-fx-background-color: #0f8fa3; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;" text="Iniciar sesión" />
    <Button onAction="#limpiarLogin" prefHeight="40" prefWidth="330" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 5; -fx-text-fill: #475569;" text="Limpiar" />

    <Label style="-fx-font-size: 11px; -fx-text-fill: #94a3b8;" text="Usuario demo: admin  |  Contraseña: 1234" />
</VBox>
